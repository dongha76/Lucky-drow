        <div class="bg-[#111] border-2 border-[#FF007F] p-8 max-w-sm w-full mx-4 relative transform scale-95 transition-transform duration-300 mecha-panel-right">
            <h3 class="text-2xl text-[#FF007F] mb-4 text-center tracking-widest">WARNING</h3>
            <p id="alert-msg" class="text-lg text-white text-center mb-6 font-sans">메시지</p>
            <button id="close-modal" class="w-full py-3 bg-[#B71C1C] hover:bg-red-700 text-white font-bold transition-colors border border-white">확인</button>
        </div>
    </div>

    <script>
        // 초기 건프라 동호회 명단 (20~30명)
        const initialNames = [
            "아무로 레이", "샤아 아즈나블", "카미유 비단", "쥬도 아시타", "시로 아마다", 
            "가토", "크리스티나", "버나지 링크스", "풀 프론탈", "하사웨이 노아",
            "세츠나", "록온", "알렐루야", "티에리아", "히이로 유이", 
            "듀오 맥스웰", "도몬 캇슈", "동방불패", "미카즈키", "올가 이츠카",
            "슬레타 머큐리", "미오리네", "구엘 제타크", "엘란 케레스", "샤디크"
        ];

        // SD 건담/자쿠 얼굴 SVG 파티클 소스
        const rawSvgs = [
            // First Gundam
            `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><rect width="80" height="80" x="10" y="10" fill="white" rx="10"/><polygon points="50,15 20,40 30,50 50,35 70,50 80,40" fill="#FFD700"/><polygon points="45,80 55,80 50,90" fill="red"/><rect x="25" y="50" width="15" height="10" fill="#00E5FF"/><rect x="60" y="50" width="15" height="10" fill="#00E5FF"/></svg>`,
            // Zaku (Green)
            `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="45" fill="#4B5320"/><rect x="10" y="40" width="80" height="20" fill="#111"/><circle cx="40" cy="50" r="10" fill="#FF007F"/></svg>`,
            // Char's Zaku (Red)
            `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="45" fill="#B71C1C"/><rect x="10" y="40" width="80" height="20" fill="#111"/><circle cx="60" cy="50" r="10" fill="#FF007F"/><polygon points="50,5 40,25 60,25" fill="#B71C1C"/></svg>`
        ];
        
        // Background-image로 사용하기 위해 Data URI로 인코딩
        const particleImages = rawSvgs.map(svg => 'url("data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg) + '")');

        // DOM 요소
        const textarea = document.getElementById('participants');
        const countDisplay = document.getElementById('count-display');
        const drawBtn = document.getElementById('draw-btn');
        const resetBtn = document.getElementById('reset-btn');
        const slotReel = document.getElementById('slot-reel');
        const winnersList = document.getElementById('winners-list');
        const emptyWinnerMsg = document.getElementById('empty-winner-msg');
        
        const alertModal = document.getElementById('alert-modal');
        const alertMsg = document.getElementById('alert-msg');
        const closeModalBtn = document.getElementById('close-modal');

        // 초기화
        textarea.value = initialNames.join('\n');
        updateCount();
        textarea.addEventListener('input', updateCount);

        function getNames() {
            return textarea.value.split('\n')
                .map(name => name.trim())
                .filter(name => name.length > 0);
        }

        function updateCount() {
            countDisplay.textContent = getNames().length;
        }

        // 경고 모달
        function showAlert(msg) {
            alertMsg.textContent = msg;
            alertModal.classList.remove('hidden');
            setTimeout(() => {
                alertModal.classList.remove('opacity-0');
                alertModal.children[0].classList.remove('scale-95');
                alertModal.children[0].classList.add('scale-100');
            }, 10);
        }

        closeModalBtn.addEventListener('click', () => {
            alertModal.classList.add('opacity-0');
            alertModal.children[0].classList.remove('scale-100');
            alertModal.children[0].classList.add('scale-95');
            setTimeout(() => alertModal.classList.add('hidden'), 300);
        });

        // 파티클 (SD건담) 폭죽 애니메이션
        function fireMechaParticles() {
            const container = document.getElementById('particle-container');
            const particleCount = 60; // 튀어오를 파티클 개수
            const centerX = window.innerWidth / 2;
            const bottomY = window.innerHeight;

            for(let i=0; i<particleCount; i++) {
                const p = document.createElement('div');
                p.className = 'sd-particle';
                
                // 크기 40px ~ 70px 랜덤
                const size = Math.random() * 30 + 40; 
                p.style.width = size + 'px';
                p.style.height = size + 'px';
                
                // 이미지 랜덤 선택 (퍼스트, 양산형 자쿠, 샤아 자쿠)
                p.style.backgroundImage = particleImages[Math.floor(Math.random() * particleImages.length)];
                
                // 물리 변수 설정 (위로 솟구치도록)
                let x = centerX;
                let y = bottomY + 50;
                let vx = (Math.random() - 0.5) * 30; // 좌우 퍼짐
                let vy = -(Math.random() * 25 + 20); // 위로 솟구치는 힘
                let rot = Math.random() * 360; // 초기 회전각
                let rotV = (Math.random() - 0.5) * 15; // 회전 속도

                container.appendChild(p);

                // 개별 파티클 애니메이션 루프
                function animateParticle() {
                    vy += 0.8; // 중력 가속도
                    x += vx;
                    y += vy;
                    rot += rotV;

                    p.style.transform = `translate(-50%, -50%) rotate(${rot}deg)`;
                    p.style.left = x + 'px';
                    p.style.top = y + 'px';

                    // 화면 아래로 완전히 떨어지면 제거
                    if (y > window.innerHeight + 100) {
                        p.remove();
                    } else {
                        requestAnimationFrame(animateParticle);
                    }
                }
                
                // 딜레이를 살짝 주어 연속적으로 터지는 느낌 부여
                setTimeout(() => requestAnimationFrame(animateParticle), Math.random() * 200);
            }
        }

        // 추첨 로직
        let isSpinning = false;
        let winnerCount = 0;

        drawBtn.addEventListener('click', () => {
            if (isSpinning) return;

            const names = getNames();
            if (names.length === 0) {
                showAlert('추첨할 명단이 비어있습니다. 작전을 중지합니다.');
                return;
            }

            isSpinning = true;
            
            // 버튼 상태 변경
            drawBtn.style.pointerEvents = 'none';
            drawBtn.style.opacity = '0.7';
            drawBtn.innerHTML = '탐색 중...';

            const winnerIndex = Math.floor(Math.random() * names.length);
            const winnerName = names[winnerIndex];

            // 릴(Reel) 설정
            const itemHeight = window.innerWidth >= 640 ? 256 : 192; // sm:h-64(256px), h-48(192px)
            const totalSpins = 30; 
            const duration = 3000; 

            slotReel.innerHTML = '';
            
            // 시작 아이템
            const startItem = document.createElement('div');
            startItem.style.height = `${itemHeight}px`;
            startItem.className = 'flex items-center justify-center text-5xl text-gray-500 w-full tracking-widest';
            startItem.textContent = 'SYS.DRAW';
            slotReel.appendChild(startItem);

            // 더미 아이템들
            for (let i = 1; i < totalSpins; i++) {
                const randomName = names[Math.floor(Math.random() * names.length)];
                const item = document.createElement('div');
                item.style.height = `${itemHeight}px`;
                item.className = 'flex items-center justify-center text-4xl sm:text-5xl text-[#00E5FF] w-full tracking-widest drop-shadow-[0_0_5px_#00E5FF] px-4 truncate';
                item.textContent = randomName;
                slotReel.appendChild(item);
            }

            // 진짜 당첨자 (마지막)
            const winnerItem = document.createElement('div');
            winnerItem.style.height = `${itemHeight}px`;
            winnerItem.className = 'flex items-center justify-center text-5xl sm:text-6xl text-[#FFD700] w-full tracking-widest drop-shadow-[0_0_10px_#FFD700] px-4 truncate bg-red-900 bg-opacity-30';
            winnerItem.textContent = winnerName;
            slotReel.appendChild(winnerItem);

            slotReel.style.transition = 'none';
            slotReel.style.transform = `translateY(0px)`;
            void slotReel.offsetWidth; // Reflow

            // 애니메이션 실행
            slotReel.style.transition = `transform ${duration}ms cubic-bezier(0.1, 0.9, 0.2, 1)`;
            slotReel.style.transform = `translateY(-${totalSpins * itemHeight}px)`;

            setTimeout(() => {
                // 커스텀 SD 파티클 발사!
                fireMechaParticles();

                if (emptyWinnerMsg) emptyWinnerMsg.style.display = 'none';
                winnerCount++;

                // 당첨자 UI 생성
                const li = document.createElement('li');
                li.className = 'bg-[#1a0505] border border-[#B71C1C] p-3 flex items-center justify-between shadow-[0_0_10px_rgba(183,28,28,0.5)] transform translate-x-4 opacity-0 transition-all duration-500';
                
                const rankBadge = document.createElement('span');
                rankBadge.className = 'bg-[#B71C1C] text-white sci-fi-font text-xl px-3 py-1 text-center border border-white';
                rankBadge.textContent = 'NO.' + winnerCount;

                const nameSpan = document.createElement('span');
                nameSpan.className = 'text-2xl text-[#FFD700] flex-1 text-center truncate px-2 font-sans font-bold';
                nameSpan.textContent = winnerName;

                li.appendChild(rankBadge);
                li.appendChild(nameSpan);
                winnersList.prepend(li); 

                setTimeout(() => li.classList.remove('translate-x-4', 'opacity-0'), 50);

                // 명단에서 당첨자 제거
                names.splice(winnerIndex, 1);
                textarea.value = names.join('\n');
                updateCount();

                // 버튼 복구
                drawBtn.innerHTML = '추첨하기';
                drawBtn.style.pointerEvents = 'auto';
                drawBtn.style.opacity = '1';
                
                isSpinning = false;

            }, duration + 100);
        });

        // 초기화 버튼 로직
        resetBtn.addEventListener('click', () => {
            if (isSpinning) return; 
            
            textarea.value = initialNames.join('\n');
            updateCount();

            slotReel.style.transition = 'none';
            slotReel.style.transform = `translateY(0px)`;
            slotReel.innerHTML = `
                <div class="h-48 sm:h-64 flex items-center justify-center text-4xl sm:text-6xl text-gray-500 drop-shadow-[0_0_8px_rgba(0,229,255,0.5)] w-full tracking-widest">
                    STANDBY...
                </div>
            `;

            winnersList.innerHTML = '';
            winnerCount = 0;
            if (emptyWinnerMsg) {
                emptyWinnerMsg.style.display = 'block';
                winnersList.appendChild(emptyWinnerMsg);
            }
            
            // 기존 흩날리던 파티클 제거
            document.getElementById('particle-container').innerHTML = '';
        });
    </script>
</body>
</html>
