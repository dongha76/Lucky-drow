            </div>

            <!-- 당첨자 명단 -->
            <div class="mecha-panel-right p-6 flex-1 flex flex-col min-h-[250px]">
                <h2 class="text-2xl text-[#FFD700] mb-3 tracking-widest border-b border-[#B71C1C] pb-2">🎖️ 에이스 파일럿 (당첨자)</h2>
